---
import type { Locale } from "@/i18n/ui";

import { useTranslations } from "@/i18n/utils";

interface Props {
	locale: Locale;
	total: string;
}

const { locale, total } = Astro.props;
const t = useTranslations(locale);
---

<div class="mt-3 flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-muted">
	<span class="tabular-nums">{total}</span>
	<span class="flex items-center gap-1" aria-hidden="true">
		{t("contributions.less")}
		{[0, 1, 2, 3, 4].map((level) => (
			<span class="size-2.5 rounded-xs" style={{ backgroundColor: `var(--graph-${level})` }} />
		))}
		{t("contributions.more")}
	</span>
</div>

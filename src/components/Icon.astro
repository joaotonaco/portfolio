export type IconName = keyof typeof paths;

interface Props extends HTMLAttributes<"svg"> {
	name: IconName;
	size?: number;
}

const { name, size = 16, ...rest } = Astro.props;
---

<svg
	xmlns="http://www.w3.org/2000/svg"
	width={size}
	height={size}
	viewBox="0 0 24 24"
	fill="none"
	stroke="currentColor"
	stroke-width="2"
	stroke-linecap="round"
	stroke-linejoin="round"
	aria-hidden="true"
	{...rest}
	set:html={paths[name]}
/>

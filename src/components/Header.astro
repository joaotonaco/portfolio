---
import { Image } from "astro:assets";
import { profile } from "@/data/profile";
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import LocalTime from "./islands/LocalTime";
import LanguageSwitch from "./LanguageSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const t = useTranslations(locale);
---

<header
	class="grid grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-x-3 gap-y-3 pt-10 pb-8 sm:gap-x-4 sm:gap-y-0 sm:pt-20"
	data-enter
	style={{ "--i": 0 }}
>
	<Image
		src={profile.avatar}
		alt={profile.name}
		width={64}
		height={64}
		loading="eager"
		densities={[1, 2]}
		class="size-12 rounded-xl border border-border sm:row-span-2 sm:size-16"
	/>
	<div class="min-w-0 sm:self-end">
		<h1 class="truncate font-medium">{profile.name}</h1>
		<p class="truncate font-mono text-xs text-muted">{t("header.role")}</p>
	</div>
	<div class="flex items-center gap-1 self-start sm:row-span-2">
		<LanguageSwitch locale={locale} label={t("header.language")} />
		<ThemeToggle label={t("header.theme")} />
	</div>
	<div class="col-span-3 sm:col-span-1 sm:col-start-2 sm:self-start">
		<LocalTime
			client:idle
			timeZone={profile.timeZone}
			locale={locale}
			labels={{
				same: t("header.timeSame"),
				ahead: t("header.timeAhead"),
				behind: t("header.timeBehind"),
			}}
		/>
	</div>
</header>

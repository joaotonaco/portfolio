---
import Icon from "./Icon.astro";

interface Props {
	label: string;
}

const { label } = Astro.props;
---

<button
	type="button"
	data-theme-toggle
	aria-label={label}
	title={label}
	class="pressable relative grid size-9 place-items-center rounded-lg text-muted hover:bg-subtle hover:text-foreground"
>
	<Icon
		name="sun"
		class="motion-transform col-start-1 row-start-1 transition-[opacity,rotate,scale] duration-200 ease-out dark:scale-90 dark:-rotate-45 dark:opacity-0"
	/>
	<Icon
		name="moon"
		class="motion-transform col-start-1 row-start-1 scale-90 rotate-45 opacity-0 transition-[opacity,rotate,scale] duration-200 ease-out dark:scale-100 dark:rotate-0 dark:opacity-100"
	/>
</button>

<script>
	document.addEventListener("click", (event) => {
		const button = (event.target as Element).closest("[data-theme-toggle]");
		if (!button) return;

		const root = document.documentElement;
		const dark = !root.classList.contains("dark");

		root.classList.add("no-transitions");
		root.classList.toggle("dark", dark);
		try {
			localStorage.setItem("theme", dark ? "dark" : "light");
		} catch {}
		requestAnimationFrame(() =>
			requestAnimationFrame(() => root.classList.remove("no-transitions")),
		);
	});
</script>

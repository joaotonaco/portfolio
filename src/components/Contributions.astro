---
import type { Locale } from "@/i18n/ui";

import { useTranslations } from "@/i18n/utils";
import { placeholderWeeks } from "@/lib/github";

import ContributionLegend from "./ContributionLegend.astro";
import ContributionsBody from "./ContributionsBody.astro";
import ContributionGraph from "./islands/ContributionGraph";
import Section from "./Section.astro";

interface Props {
	locale: Locale;
	index: number;
}

const { locale, index } = Astro.props;
const t = useTranslations(locale);
---

<Section label={t("contributions.label")} id="contributions" index={index}>
	<ContributionsBody server:defer locale={locale}>
		<div slot="fallback" aria-busy="true" class="animate-pulse">
			<ContributionGraph
				weeks={placeholderWeeks()}
				locale={locale}
				label=""
				tooltip={{ one: "", other: "" }}
			/>
			<ContributionLegend locale={locale} total=" " />
		</div>
	</ContributionsBody>
</Section>

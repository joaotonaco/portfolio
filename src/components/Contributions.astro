---
import type { Locale } from "@/i18n/ui";
import { useTranslations } from "@/i18n/utils";
import { getContributions } from "@/lib/github";
import ContributionGraph from "./islands/ContributionGraph";
import Section from "./Section.astro";

interface Props {
	locale: Locale;
	index: number;
}

const { locale, index } = Astro.props;
const t = useTranslations(locale);
const data = await getContributions();
const total = data ? t("contributions.total", { n: data.total.toLocaleString(locale) }) : "";
---

<Section label={t("contributions.label")} id="contributions" index={index}>
	{data ? (
		<>
			<ContributionGraph
				client:visible
				weeks={data.weeks}
				locale={locale}
				label={total}
				tooltip={{ one: t("contributions.tooltipOne"), other: t("contributions.tooltipOther") }}
			/>
			<div class="mt-3 flex flex-wrap items-center justify-between gap-2 font-mono text-[11px] text-muted">
				<span class="tabular-nums">{total}</span>
				<span class="flex items-center gap-1" aria-hidden="true">
					{t("contributions.less")}
					{[0, 1, 2, 3, 4].map((level) => (
						<span
							class="size-2.5 rounded-[2px]"
							style={{ backgroundColor: `var(--graph-${level})` }}
						/>
					))}
					{t("contributions.more")}
				</span>
			</div>
		</>
	) : (
		<p class="text-sm text-muted">{t("contributions.empty")}</p>
	)}
</Section>

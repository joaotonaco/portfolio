---
import Contributions from "@/components/Contributions.astro";
import Experience from "@/components/Experience.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Hero from "@/components/Hero.astro";
import Projects from "@/components/Projects.astro";
import Stack from "@/components/Stack.astro";
import { isLocale, useTranslations } from "@/i18n/utils";
import Base from "@/layouts/Base.astro";

export const prerender = false;

const { locale } = Astro.params;
if (!isLocale(locale)) return new Response(null, { status: 404 });

const t = useTranslations(locale);
Astro.response.headers.set("Cache-Control", "public, max-age=600");
---

<Base locale={locale} title={t("meta.title")} description={t("meta.description")} path="/">
	<div class="mx-auto w-full max-w-230 px-5 sm:px-8">
		<Header locale={locale} />
		<main>
			<Hero locale={locale} />
			<Experience locale={locale} index={5} />
			<Projects locale={locale} index={6} />
			<Stack locale={locale} index={7} />
			<Contributions locale={locale} index={8} />
		</main>
		<Footer locale={locale} index={9} />
	</div>
</Base>

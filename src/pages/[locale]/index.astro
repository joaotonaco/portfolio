---
import About from "@/components/About.astro";
import Contributions from "@/components/Contributions.astro";
import Experience from "@/components/Experience.astro";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Projects from "@/components/Projects.astro";
import Stack from "@/components/Stack.astro";
import { locales } from "@/i18n/ui";
import { getLocale, useTranslations } from "@/i18n/utils";
import Base from "@/layouts/Base.astro";

export function getStaticPaths() {
	return locales.map((locale) => ({ params: { locale } }));
}

const locale = getLocale(Astro.params.locale);
const t = useTranslations(locale);
---

<Base locale={locale} title={t("meta.title")} description={t("meta.description")} path="/">
	<main class="mx-auto w-full max-w-[640px] px-4 sm:px-6">
		<Header locale={locale} />
		<About locale={locale} />
		<Experience locale={locale} index={2} />
		<Projects locale={locale} index={3} />
		<Contributions locale={locale} index={4} />
		<Stack locale={locale} index={5} />
		<Footer locale={locale} index={6} />
	</main>
</Base>
